<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
      <TargetFramework>net10.0</TargetFramework>

      <PackageId>DreamWalkerJK.EFCore.BulkExtensions.Core</PackageId>
      <PackageVersion>10.0.1-gaussdb.1</PackageVersion>
      <Authors>borisdj, DreamWalkerJK</Authors>
      <PackageProjectUrl>https://github.com/DreamWalkerJK/EFCore.BulkExtensions</PackageProjectUrl>
      <RepositoryUrl>https://github.com/DreamWalkerJK/EFCore.BulkExtensions</RepositoryUrl>
      <RepositoryType>Git</RepositoryType>
      <PackageReleaseNotes>GaussDB support preview release 1.</PackageReleaseNotes>

      <Title>EFCore.BulkExtensions.Core</Title>
      <RootNamespace>EFCore.BulkExtensions</RootNamespace>
      <Description>EntityFramework Core bulk operations core library with GaussDB support.</Description>
	<NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.3" />
    <PackageReference Include="MedallionTopologicalSort" Version="1.0.0" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EFCore.BulkExtensions.SqlServer,PublicKey=''" />
	<InternalsVisibleTo Include="EFCore.BulkExtensions.PostgreSql,PublicKey=''" />
	<!--InternalsVisibleTo Include="EFCore.BulkExtensions.MySql,PublicKey=''" />
	<InternalsVisibleTo Include="EFCore.BulkExtensions.GBase,PublicKey=''" /-->
    <InternalsVisibleTo Include="EFCore.BulkExtensions.Oracle,PublicKey=''" />
    <InternalsVisibleTo Include="EFCore.BulkExtensions.Sqlite,PublicKey=''" />
    <InternalsVisibleTo Include="EFCore.BulkExtensions.Tests,PublicKey=''" />
  </ItemGroup>
</Project>