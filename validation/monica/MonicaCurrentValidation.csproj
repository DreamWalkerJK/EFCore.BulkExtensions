<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BulkExtensionsRoot Condition="'$(BulkExtensionsRoot)' == ''">$(MSBuildThisFileDirectory)..\..</BulkExtensionsRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="vendor\**" />
    <ProjectReference Include="vendor\Monica\Monica.Repository\Monica.Repository.csproj" />
    <ProjectReference Include="$(BulkExtensionsRoot)\EFCore.BulkExtensions.GaussDB\EFCore.BulkExtensions.GaussDB.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="source-commit.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
