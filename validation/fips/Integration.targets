<Project>
  <!-- Preserve each source repository's real targets while replacing the consumer dependency. -->
  <Import Project="$(FipsRoot)/Directory.Build.targets"
          Condition="Exists('$(FipsRoot)/Directory.Build.targets') And $([System.String]::Copy('$(MSBuildProjectFullPath)').StartsWith('$(FipsRoot)'))" />
  <Import Project="$(MonicaRoot)/Directory.Build.targets"
          Condition="Exists('$(MonicaRoot)/Directory.Build.targets') And $([System.String]::Copy('$(MSBuildProjectFullPath)').StartsWith('$(MonicaRoot)'))" />
  <ItemGroup>
    <_OfficialBulk Include="@(PackageReference->WithMetadataValue('Identity', 'EFCore.BulkExtensions'))" />
    <PackageReference Remove="EFCore.BulkExtensions" />
    <ProjectReference Include="$(BulkExtensionsRoot)/EFCore.BulkExtensions.GaussDB/EFCore.BulkExtensions.GaussDB.csproj"
                      Condition="'@(_OfficialBulk)' != ''" />
  </ItemGroup>
</Project>
