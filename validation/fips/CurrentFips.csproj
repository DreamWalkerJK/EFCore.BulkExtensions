<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <BulkExtensionsRoot Condition="'$(BulkExtensionsRoot)' == ''">$(MSBuildThisFileDirectory)..\..</BulkExtensionsRoot>
    <FipsRoot Condition="'$(FipsRoot)' == ''">$(BulkExtensionsRoot)\..\FIPS\FIPS2022</FipsRoot>
    <MonicaRoot Condition="'$(MonicaRoot)' == ''">$(BulkExtensionsRoot)\..\FIPS\MoLibrary</MonicaRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(BulkExtensionsRoot)/EFCore.BulkExtensions.GaussDB/EFCore.BulkExtensions.GaussDB.csproj" />
    <ProjectReference Include="$(FipsRoot)/src/Services/Flight/FlightService.Domain/FlightService.Domain.csproj" />
    <ProjectReference Include="$(FipsRoot)/src/Services/User/UserService.Domain/UserService.Domain.csproj" />
    <ProjectReference Include="$(FipsRoot)/src/Services/File/FileService.Domain/FileService.Domain.csproj" />
    <ProjectReference Include="$(FipsRoot)/src/Services/MilitaryFlight/MilitaryFlightService.Domain/MilitaryFlightService.Domain.csproj" />
    <ProjectReference Include="$(FipsRoot)/src/Services/DataExchange/DataExchangeService.Domain/DataExchangeService.Domain.csproj" />
    <ProjectReference Include="$(MonicaRoot)/Monica.Testing/Monica.Testing.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
  </ItemGroup>
</Project>
